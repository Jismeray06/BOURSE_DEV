# Copiez ce fichier en .env puis renseignez vos propres valeurs (identifiants Google Cloud, SMTP, secrets).
# Ne mettez JAMAIS de vrais secrets dans ce fichier : il est versionné.
GOOGLE_CLIENT_ID=remplacez-par-votre-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

FRONTEND_URL=http://localhost:3000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=remplacez-par-votre-identifiant-smtp
SMTP_PASS=remplacez-par-votre-mot-de-passe-smtp
SMTP_FROM="Plateforme d'inscription <no-reply@example.com>"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inscription_mahajanga?schema=public"
# Utilisez des valeurs personnelles et robustes avant la mise en production.
AUTH_TOKEN_SECRET=remplacez-cette-cle-par-une-cle-longue-et-aleatoire
ADMIN_EMAIL=admin@univ-mahajanga.mg
ADMIN_PASSWORD=Changez-Moi-2026!
ADMIN_NAME=Administrateur Université
ISSTM_MANAGER_EMAIL=responsable.isstm@univ-mahajanga.mg
ISSTM_MANAGER_PASSWORD=ISSTM-2026!
ISSTM_MANAGER_NAME=Responsable ISSTM
SCOLARITE_EMAIL=scolarite@univ-mahajanga.mg
SCOLARITE_PASSWORD=Changez-Moi-2026!
SCOLARITE_NAME=Scolarité Centrale
ISSTM_STUDENT_PASSWORD=ISSTM-2026!
