generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ETUDIANT
  ADMIN
  ETABLISSEMENT
  ADMIN_ETABLISSEMENT
  SECRETAIRE
  SCOLARITE_CENTRALE
}

enum RegistrationStatus {
  BROUILLON
  SOUMIS
  EN_REVISION
  VALIDE
  REFUSE
}

enum Gender {
  FEMININ
  MASCULIN
  AUTRE
}

enum CurriculumOptionType {
  NIVEAU
  PARCOURS
}

enum CurriculumCycle {
  LICENCE
  MASTER
}

enum DocumentRequirementContext {
  INSCRIPTION
  CANDIDATURE
}

enum EnrollmentQuality {
  PASSANT
  REDOUBLANT
}

model User {
  id                 String             @id @default(cuid())
  fullName           String
  email              String             @unique
  passwordHash       String?
  emailVerified      Boolean            @default(false)
  active             Boolean            @default(true)
  role               UserRole           @default(ETUDIANT)
  registrationStatus RegistrationStatus @default(BROUILLON)
  establishment      String?
  level              String?
  program            String?
  avatarUrl          String?
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  quitus             Quitus[]
  application        EnrollmentApplication?
  enrolledStudent    EnrolledStudent?
  reviewedApplications EnrollmentApplication[] @relation("ApplicationReviewer")
  emailVerificationTokens EmailVerificationToken[]
  quitusChallenges   QuitusChallenge[]
  emailChangeRequests EmailChangeRequest[]
  notifications      Notification[]
}

enum AuditAction {
  STAFF_ACCOUNT_CREATED
  STAFF_ACCOUNT_STATUS_CHANGED
  STAFF_ACCOUNT_NAME_UPDATED
  STAFF_ACCOUNT_PASSWORD_RESET
  STAFF_ACCOUNT_TRASHED
  STAFF_ACCOUNT_RESTORED
  STAFF_ACCOUNT_PURGED
  ACCOUNT_PASSWORD_CHANGED
  ACCOUNT_EMAIL_CHANGED
  HOMEPAGE_CONTENT_UPDATED
  HOMEPAGE_IMAGE_UPDATED
  HOMEPAGE_CAROUSEL_UPDATED
  HOMEPAGE_NEWS_CREATED
  HOMEPAGE_NEWS_UPDATED
  HOMEPAGE_NEWS_DELETED
}

model AuditLogEntry {
  id         String      @id @default(cuid())
  action     AuditAction
  actorId    String?
  actorName  String
  targetId   String?
  targetName String
  detail     String?
  createdAt  DateTime    @default(now())

  @@index([createdAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Demande de changement d'adresse e-mail : appliquée seulement après clic sur le lien reçu à la nouvelle adresse.
model EmailChangeRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Notification affichée dans la cloche de l'utilisateur (ex. : décision sur son dossier de bourse).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Quitus {
  id            String   @id @default(cuid())
  code          String   @unique
  studentName   String
  studentEmail  String?
  establishment String
  issuedAt      DateTime @default(now())
  issuedById    String?
  issuedBy      User?    @relation(fields: [issuedById], references: [id])
  enrollmentId  String?  @unique
  enrollment    EnrolledStudent? @relation(fields: [enrollmentId], references: [id])
  application  EnrollmentApplication?
  challenges   QuitusChallenge[]
}

// Code à 6 chiffres envoyé à l'e-mail enregistré par l'établissement pour prouver
// que le demandeur est bien le titulaire du quitus.
model QuitusChallenge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quitusId  String
  quitus    Quitus   @relation(fields: [quitusId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, quitusId])
  @@index([expiresAt])
}

model EnrollmentApplication {
  id            String             @id @default(cuid())
  userId        String             @unique
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  establishment String
  level         String
  program       String
  quitusId      String?            @unique
  quitus        Quitus?            @relation(fields: [quitusId], references: [id])
  status        RegistrationStatus @default(BROUILLON)
  submittedAt   DateTime?
  reviewNote    String?
  reviewedAt    DateTime?
  reviewedById  String?
  reviewedBy    User?              @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  documents     ApplicationDocument[]
}

model ApplicationDocument {
  id            String                @id @default(cuid())
  applicationId String
  type          String
  originalName  String
  storageName   String                @unique
  mimeType      String
  size          Int
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  application   EnrollmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, type])
  @@index([applicationId])
}

model EnrolledStudent {
  id                 String   @id @default(cuid())
  registrationNumber String   @unique
  fullName           String
  email              String?  @unique
  phone              String
  gender             Gender
  registrationForm   String   @default("LICENCE")
  birthDatePlace     String?
  cin                String?
  nationality        String?
  address            String?
  previousEstablishment String?
  bacYear            String?
  bacSeries          String?
  bacCenter          String?
  previousUniversityRegistration Boolean?
  fatherName         String?
  motherName         String?
  parentsPhone       String?
  parentsCity        String?
  respondentName     String?
  respondentPhone    String?
  respondentAddress  String?
  maritalStatus      String?
  licenceYear        String?
  mention            String?
  previousLevel      String?
  previousProgram    String?
  quality            EnrollmentQuality?
  establishment      String
  level              String
  program            String
  active             Boolean  @default(true)
  userId             String?  @unique
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  quitus             Quitus?
  documents          EnrolledStudentDocument[]
}

model EnrolledStudentDocument {
  id                String          @id @default(cuid())
  enrolledStudentId String
  type              String
  originalName      String
  storageName       String          @unique
  mimeType          String
  size              Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  enrolledStudent   EnrolledStudent @relation(fields: [enrolledStudentId], references: [id], onDelete: Cascade)

  @@unique([enrolledStudentId, type])
  @@index([enrolledStudentId])
}

model EstablishmentCurriculumOption {
  id            String               @id @default(cuid())
  establishment String
  type          CurriculumOptionType
  name          String
  cycle         CurriculumCycle      @default(LICENCE)
  active        Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([establishment, type, name, cycle])
  @@index([establishment, type, active])
}

model DocumentRequirement {
  id            String                      @id @default(cuid())
  establishment String
  context       DocumentRequirementContext  @default(INSCRIPTION)
  cycle         CurriculumCycle             @default(LICENCE)
  type          String
  label         String
  active        Boolean                     @default(true)
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  @@unique([establishment, context, cycle, type])
  @@index([establishment, context, cycle, active])
}

// Établissements proposés aux étudiants. Le nom est la valeur stockée partout ailleurs
// (comptes, dossiers, quitus…) : le renommer met à jour toutes ces tables.
model Establishment {
  id        String   @id @default(cuid())
  name      String   @unique
  logoUrl   String?
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EstablishmentSettings {
  establishment String   @id
  mention       String?
  interfaceSettings Json?
  updatedAt     DateTime @updatedAt
}

enum HeroBackgroundType {
  COLOR
  GRADIENT
  IMAGE
}

model SiteSettings {
  id                  String             @id @default("default")
  primaryColor        String             @default("#0b3b60")
  secondaryColor      String             @default("#fbbf24")
  backgroundColor     String             @default("#ffffff")
  logoUrl             String?
  faviconUrl          String?
  heroBackgroundType  HeroBackgroundType @default(IMAGE)
  heroBackgroundImages String[]         @default([])
  heroOverlayOpacity  Int                @default(60)
  heroTitle           String             @default("Votre inscription universitaire, simple et accessible.")
  heroSubtitle        String             @default("Déposez votre dossier d'inscription en ligne en quelques étapes. Sélectionnez votre établissement, validez votre quitus et suivez l'avancement de votre dossier.")
  ctaPrimaryLabel     String             @default("Se connecter")
  ctaPrimaryLink      String             @default("/login")
  ctaSecondaryLabel   String             @default("Commencer mon inscription")
  ctaSecondaryLink    String             @default("/login")
  homepageContent     Json               @default("{}")
  homepageNews        Json               @default("[]")
  updatedAt           DateTime           @updatedAt
}
